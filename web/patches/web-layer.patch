+// ─── Local web version: first-run setup + locally stored credentials ──────────
+// All /api/web/* routes (except the harmless status probe) require:
+//  • Host to be localhost / 127.0.0.1 on our port  → blocks DNS-rebinding attacks
+//  • Origin (if sent) to be ourselves              → blocks other sites calling us
+//  • a custom x-flux-web header                    → cross-site requests can't set it
+function webGuard(req, res, next) {
+  const host = String(req.headers.host || '').toLowerCase();
+  const origin = req.headers.origin;
+  const okHost = host === `localhost:${PORT}` || host === `127.0.0.1:${PORT}`;
+  const okOrigin = !origin || origin === `http://${host}`;
+  if (!IS_WEB) return res.status(404).json({ error: 'Not available' });
+  if (!okHost || !okOrigin || req.headers['x-flux-web'] !== '1') {
+    return res.status(403).json({ error: 'Forbidden' });
+  }
+  next();
+}
+
+function readCreds() {
+  try {
+    const c = JSON.parse(readFileSync(CREDS_FILE, 'utf8'));
+    return { bfl: String(c.bfl || ''), topaz: String(c.topaz || '') };
+  } catch { return { bfl: '', topaz: '' }; }
+}
+function writeCreds(c) {
+  writeFileSync(CREDS_FILE, JSON.stringify(c, null, 2), { mode: 0o600 });
+  try { chmodSync(CREDS_FILE, 0o600); } catch { /* not supported on Windows */ }
+}
+
+function resolveUserDir(input) {
+  let p = String(input || '').trim().replace(/^["']+|["']+$/g, '');
+  if (!p) throw new Error('Please enter a folder path.');
+  if (p === '~' || p.startsWith('~/') || p.startsWith('~\\')) p = join(homedir(), p.slice(1));
+  if (!isAbsolute(p)) throw new Error(`Please enter the full path to a folder, for example ${DEFAULT_WEB_OUTPUTS}`);
+  return resolve(p);
+}
+
+function friendlyFsError(e, dir) {
+  if (e.code === 'EACCES' || e.code === 'EPERM') return `FLUX Studio doesn't have permission to write to "${dir}". Choose a folder you own, such as one inside Downloads or Documents.`;
+  if (e.code === 'EROFS') return `"${dir}" is on a read-only disk. Choose a different folder.`;
+  if (e.code === 'EEXIST' || e.code === 'ENOTDIR') return `"${dir}" is a file (or sits inside one), not a folder. Choose a different location.`;
+  return e.message;
+}
+
+function nearestExisting(p) {
+  while (!existsSync(p) && dirname(p) !== p) p = dirname(p);
+  return p;
+}
+
+function pickFolder(startDir) {
+  const prompt = 'Choose where FLUX Studio saves your images and videos';
+  const run = (cmd, args) => new Promise((ok, fail) => {
+    execFile(cmd, args, { timeout: 10 * 60 * 1000, windowsHide: true }, (err, stdout) => {
+      if (err && err.code === 'ENOENT') return fail(Object.assign(new Error('no picker'), { code: 'NO_PICKER' }));
+      if (err && typeof err.code === 'number') return ok('');   // dialog cancelled / closed
+      if (err) return fail(err);
+      ok(String(stdout).trim());
+    });
+  });
+  const tidy = (p) => (p.length > 1 ? p.replace(/(?<!:)[\\/]+$/, '') : p);
+
+  if (process.platform === 'darwin') {
+    const q = (s) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
+    return run('osascript', [
+      '-e', 'try',
+      '-e', `set f to choose folder with prompt "${q(prompt)}" default location (POSIX file "${q(startDir)}")`,
+      '-e', 'return POSIX path of f',
+      '-e', 'on error number -128',
+      '-e', 'return ""',
+      '-e', 'end try',
+    ]).then(tidy);
+  }
+  if (process.platform === 'win32') {
+    const ps = `Add-Type -AssemblyName System.Windows.Forms; $d = New-Object System.Windows.Forms.FolderBrowserDialog; $d.Description = '${prompt}'; $d.ShowNewFolderButton = $true; $d.SelectedPath = '${startDir.replace(/'/g, "''")}'; if ($d.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) { Write-Output $d.SelectedPath }`;
+    return run('powershell.exe', ['-NoProfile', '-STA', '-Command', ps]).then(tidy);
+  }
+  return run('zenity', ['--file-selection', '--directory', '--title', prompt, '--filename', startDir + '/'])
